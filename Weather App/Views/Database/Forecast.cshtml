@model IEnumerable<Weather_App.Models.Forecast>

@{
    ViewData["Title"] = "Forecast";
}

<div class="container-fluid">
    <div class="d-flex justify-content-center align-content-center">
        <table class="table" style="width: 50%">
            <thead>
                <tr>
                    <th>
                        Date
                    </th>
                    <th>
                        Time
                    </th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @{
                                DateOnly date = new DateOnly(item.Year, item.Month, item.Day);
                            }
                            <p>@(date.ToString("dd-MM-yyyy")) </p>
                        </td>
                        <td>
                            @{
                                TimeOnly time = new TimeOnly(item.Hour, item.Minute);
                            }
                            <p>@(time)</p>
                        </td>
                        <td>
                            <a class="input-btn" asp-controller="Database" asp-action="Details" asp-route-id="@item.Id" >Details</a>
                        </td>
                        <td>
                            <a class="input-btn" asp-controller="Database" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .input-btn {
        text-decoration: none;
    }
</style>